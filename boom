4. The Minion Game
def minion_game(string):
k=0
s=0
vowels="AaEeIiOoUu"
for i in range(len(string)):
if string[i] in vowels:
k=k+len(string)-i
else:
s=s+len(string)-i
if k>s:
print("Kevin",k)
elif k==s:
print("Draw")
else:
print("Stuart",s)
if __name__ == '__main__':
