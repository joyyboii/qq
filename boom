15. Longest Palindromic subsequence
class Solution:
def longestPalindromeSubseq(self, s):

def dp(i, j):
if i > j:
return 0
if i == j:
return 1
if s[i] == s[j]:
return 2 + dp(i + 1, j - 1)
return max(dp(i + 1, j), dp(i, j - 1))

return dp(0, len(s) - 1)

s = input()
